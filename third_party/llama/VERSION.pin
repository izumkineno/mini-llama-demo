# 头文件（同 tag 源码取头，仅用于隐式链接声明；C1 零源码编译不受影响）
headers_source_tag=b11669
headers=llama.h(90731B) ggml.h(116594B) ggml-alloc.h(3689B) ggml-backend.h(27570B) ggml-opt.h(14040B) llama-cpp.h(1102B)
