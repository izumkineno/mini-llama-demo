# 导入库（官方 win 包不带 .lib；由 llama.dll 经 dumpbin /exports → .def → lib.exe 生成，280 exports）
import_lib=lib/llama.lib
import_lib_tool=VS2022-MSVC-14.44.35207-dumpbin+lib
import_lib_deffile=llama.def

